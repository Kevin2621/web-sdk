{
  "name": "wild-pickins",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "format": "prettier --write --ignore-path=../../.prettierignore .",
    "lint": "eslint \"src\"",
    "storybook": "PUBLIC_CHROMATIC=true storybook dev -p 6011 public",
    "dev": "vite dev --host --port 3011",
    "build": "vite build",
    "preview": "vite preview",
    "render:letters": "node --experimental-strip-types scripts/render-letters.mjs",
    "test:audio": "node --experimental-strip-types --test src/game/scatterSound.test.mjs src/game/interactionCues.test.mjs src/game/templatePayout.test.mjs src/game/bonusCues.test.mjs src/game/seedCelebration.test.mjs src/game/bonusEnding.test.mjs src/game/audioWorkbench.test.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@storybook/addon-svelte-csf": "5.0.5",
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "chromatic": "11.26.1",
    "config-lingui": "workspace:*",
    "config-storybook": "workspace:*",
    "config-svelte": "workspace:*",
    "config-ts": "workspace:*",
    "config-vite": "workspace:*",
    "eslint": "9.21.0",
    "eslint-config-custom": "workspace:*"
  },
  "dependencies": {
    "@lingui/core": "5.2.0",
    "@sveltejs/kit": "2.17.3",
    "@types/lodash": "4.17.16",
